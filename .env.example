# ─────────────────────────────────────────────────────────────
# Powerbind Backend — environment configuration
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` — it is loaded by Spring via
# `spring.config.import=optional:file:.env[.properties]`.
# ─────────────────────────────────────────────────────────────

# ── PostgreSQL (REQUIRED) ────────────────────────────────────
DB_USERNAME=powerbind
DB_PASSWORD=change-me

# ── JWT (REQUIRED) ───────────────────────────────────────────
# Use a long random secret (e.g. 64+ hex chars)
JWT_SECRET=change-me-to-a-long-random-secret
# Access token lifetime (ms) — default 1 hour
#JWT_EXPIRATION=3600000
# Refresh token lifetime (ms) — default 7 days
#JWT_REFRESH_EXPIRATION=604800000

# ── Redis (defaults: localhost:6379) ─────────────────────────
#REDIS_HOST=localhost
#REDIS_PORT=6379

# ── MQTT / Mosquitto broker (default: tcp://localhost:1883) ──
#MQTT_BROKER_URL=tcp://localhost:1883

# Broker authentication - REQUIRED by the dockerized Mosquitto
# (allow_anonymous=false). entrypoint.sh builds the password file from these
# on every container start. Set MQTT_BACKEND_PASSWORD to a strong value.
MQTT_BACKEND_USERNAME=powerbind-backend
MQTT_BACKEND_PASSWORD=change-me
# Optional device accounts, format user:pass;user2:pass2
# Devices may publish to smart-home/presence|power|logs and read smart-home/relay.
#MQTT_DEVICE_USERS=esp32-kitchen:device-pass-1;esp32-bedroom:device-pass-2

# TLS reverse proxy (Caddy)
# SITE_ADDRESS=localhost -> self-signed internal CA (browser warning, LAN/demo)
# SITE_ADDRESS=example.com -> automatic Let's Encrypt certificate
# (ports 80 + 443 must be reachable from the internet)
#SITE_ADDRESS=localhost
# Frontend built against the HTTPS entry point instead of http://localhost:8045:
#VITE_API_URL=https://localhost

# ── InfluxDB (REQUIRED: token) ───────────────────────────────
INFLUXDB_TOKEN=change-me
#INFLUXDB_URL=http://localhost:8086
#INFLUXDB_ORG=powerbind
#INFLUXDB_BUCKET=smarthome

# ── Backup terjadwal (service `backup` di docker-compose) ────
# Jadwal cron pg_dump + influx backup (default: tiap hari 02:00)
#BACKUP_CRON=0 2 * * *
# Berapa hari backup disimpan sebelum dirotasi (default: 7)
#BACKUP_RETENTION_DAYS=7

# ── Groq AI (REQUIRED) ───────────────────────────────────────
# Get a key at https://console.groq.com
GROQ_API_KEY=change-me
#GROQ_MAX_TOKENS=1024

# ── CORS (default: http://localhost:5173) ────────────────────
#CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Initial users (seeded by DataInitializer on first start) ─
# Single default admin:
APP_DEFAULT_USER_USERNAME=admin
APP_DEFAULT_USER_PASSWORD=change-me
# ...or multiple family accounts (overrides the default admin):
# Format: username:password:DisplayName;username2:password2:DisplayName2
#APP_FAMILY_USERS=alice:password123:Alice;bob:password123:Bob

# SonarQube (for .\run-sonar-backend.ps1)
# Server URL + analysis token. Token: SonarQube UI > My Account > Security
# > Generate Token. Project key is fixed to powerbind-backend in the script.
#SONAR_HOST_URL=http://localhost:9000
#SONAR_TOKEN=paste-sonar-token-here
